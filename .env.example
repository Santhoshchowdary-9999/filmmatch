# FilmMatch AI — Environment Configuration Example
# Copy this file to .env and insert your real credentials.

# TMDB API Credentials (v3 API Key or v4 Read Access Token)
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=

# Database Configuration (Target: PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/filmmatch

# Recommendation Weights (Defaults)
DEFAULT_CONTENT_WEIGHT=0.50
DEFAULT_SENTIMENT_WEIGHT=0.20
DEFAULT_COLLAB_WEIGHT=0.30

# Fast API Backend Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
